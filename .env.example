# VEZI Environment Variables
# Copy this file to .env.local and fill in your values.

# ── Supabase (Sprint 2 – leave empty to run in mock mode) ─────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=  # Only for admin operations – never expose client-side

# ── App ───────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
